{
  "name": "rudhira",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "npm run build --prefix experience",
    "db:migrate": "node --env-file=.env.database.local scripts/migrate.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:db": "node --env-file=.env.database.local --test tests/database.test.mjs",
    "dev:api": "node --env-file=.env.local --env-file=.env.database.local scripts/dev-api.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "dotenv": "^18.0.5",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  }
}
